# --- Lucy Labs / Sloane (web) — example env (no real secrets) ---

# Fal.ai (Veo, Kling, MiniMax, Grok, stills, storage uploads, lipsync)
FAL_KEY=
FAL_ADMIN_KEY=

# BytePlus ModelArk — Seedance 2.0 + Seedance 2.5 only (server-side).
# Prefer postpaid PAYG on the BytePlus account. Sid must set the API key in
# Vercel/host env before Seedance generations work.
BYTEPLUS_ARK_API_KEY=
# Alias accepted by the client if BYTEPLUS_ARK_API_KEY is unset:
ARK_API_KEY=
# Singapore ModelArk v3 (default if unset):
# BYTEPLUS_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# Owner-only Seedance model for Director films (default seedance-1-0-pro-250528):
# BYTEPLUS_OWNER_SEEDANCE_MODEL=
# Optional model-id overrides (Dreamina Seedance documented IDs):
# BYTEPLUS_SEEDANCE_20_MODEL=dreamina-seedance-2-0-fast-260128
# BYTEPLUS_SEEDANCE_25_MODEL=dreamina-seedance-2-5-260628

# --- Everything else the app reads (documented 2026-10-17 audit) ---
# Required in production unless marked optional.

# Database (Vercel Postgres / Neon integration injects this).
POSTGRES_URL=

# Stripe. STRIPE_WEBHOOK_SECRET is the signing secret of the webhook endpoint
# (/api/billing/webhook). Subscribe that endpoint to checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# invoice.paid, customer.subscription.updated and customer.subscription.deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Legacy subscription / fixed-price ids (only needed for old checkouts):
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PLUS=
# STRIPE_PRICE_VIDEO=
# STRIPE_PRICE_VIDEO_CREDIT_1=
# STRIPE_PRICE_VIDEO_CREDIT_5=
# STRIPE_PRICE_VIDEO_CREDIT_10=

# Key for /api/media/<token> links and Copy-a-clip folders. Optional: falls
# back to a key derived from STRIPE_SECRET_KEY. Rotating it breaks old media links.
# MEDIA_URL_SECRET=

# Vercel Blob (uploads, stored Veo results, Copy-a-clip uploads).
BLOB_READ_WRITE_TOKEN=

# Vercel cron calls send "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Email (magic links, receipts, alerts) via Resend.
RESEND_API_KEY=
# Where low-balance / ops alerts go.
ADMIN_ALERT_EMAIL=
# Password for /admin (x-admin-password header).
ADMIN_DASHBOARD_PASSWORD=

# Google sign-in (OAuth client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud / Vertex AI (Veo, Gemini planner, image models). Keyless via
# Vercel OIDC workload identity (the four GCP_* vars), or a key / service account.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# GOOGLE_VERTEX_API_KEY=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional model overrides:
# GOOGLE_PLANNER_MODEL=gemini-3.8-flash
# GOOGLE_PLANNER_LOCATION=global
# GOOGLE_IMAGE_MODELS=gemini-3-pro-image,gemini-3.1-flash-image,gemini-3.1-flash-lite-image
# GOOGLE_VEO_MODEL=veo-3.1-generate-001
# GOOGLE_VEO_FAST_MODEL=veo-3.1-fast-generate-001
# GOOGLE_VEO_LITE_MODEL=veo-3.1-lite-generate-001
# VEO_PERSON_GENERATION=allow_all

# Modal (voices, TTS, stitching). One shared bearer secret for all Modal apps.
MODAL_SHARED_SECRET=
MODAL_SUBMIT_URL=
MODAL_STATUS_URL=
MODAL_STITCH_URL=
MODAL_DIRECTOR_STITCH_URL=
# MODAL_DIRECTOR_VOICE_URL=   (optional - has a default)

# Voice inference backend for the voice tools: "modal" (default) or "pod".
# INFERENCE_BACKEND=modal
# INFERENCE_SERVER_URL=
# INFERENCE_SERVER_TOKEN=
# MAC_INFERENCE_URL=
# MAC_INFERENCE_TOKEN=
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=

# Seedance direct on BytePlus in the browser model picker ("1" = on).
# NEXT_PUBLIC_SEEDANCE_DIRECT=

# Directed by Lucy switches (all optional; defaults in the code):
# DIRECTOR_AUTO_INGREDIENTS=0      (turn off Veo reference-to-video for dialogue)
# DIRECTOR_FINAL_FOR_VEO31=1       (allow "Final" 1080p for veo31 customers)
# DIRECTOR_HERO_SAMPLES=2          (multi-sample hero shots)
# DIRECTOR_LOSSLESS_MASTER=1
# DIRECTOR_LIPSYNC=                (lip-sync provider for dubs)
# DIRECTOR_SYNC_CHECK=1            (free sync check after filming)
# DIRECTOR_TTS_ENGINE=standard     (or turbo)
# DIRECTOR_LLM_SHORTEN=0           (turn off LLM prompt shortening)
# DIRECTOR_MODEL_FORMATTERS=       (per-model shot formatters)
# DIRECTOR_OWNER_SEEDANCE_2=1      (owner films on Seedance 2.x)
# DIRECTOR_SEEDANCE_REFS=1         (Seedance 2.x multimodal references)

# FAL_ADMIN_KEY (top of this file) must be an ADMIN-scoped fal key: without it
# the live fal balance guard can't run and generation is allowed through.

# Comma-separated list of account emails treated as the site owner (see
# web/src/lib/owner.ts's isOwner()). Owner accounts can use the standalone
# voice generator/cloning tool (now hidden from everyone else, 2026-10-01 -
# see STATUS.md) and get pay-as-you-go video without buying Stripe credits.
OWNER_EMAILS=

# Prompt enhancer (2026-10-16, web/src/lib/promptEnhance*.ts). No new key:
# it uses Gemini on Vertex AI (GOOGLE_CLOUD_PROJECT + the keyless Vercel OIDC
# GCP_* vars, model GOOGLE_PLANNER_MODEL, default gemini-3.8-flash), then
# fal's OpenRouter endpoint with FAL_KEY as a backup. Set to "off" to send
# prompts to the video model exactly as typed.
# PROMPT_ENHANCE=off
